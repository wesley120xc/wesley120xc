-- Seleciona o nome do país, o nome do indicador e a dívida, com o alias 'lowest_repayment'
SELECT
    country_name,
    indicator_name,
    debt AS lowest_repayment
FROM
    international_debt
-- Filtra para encontrar o código indicador 'DT.AMT.DLXF.CD'
WHERE
    indicator_code = 'DT.AMT.DLXF.CD'
-- Ordena os resultados pela dívida em ordem crescente
ORDER BY
    debt ASC
-- Limita o resultado ao valor mais baixo
LIMIT 1;

